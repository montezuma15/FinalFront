# Copiar este archivo como .env y cambiar los valores (el .env NO se sube a git)

# Base de datos
POSTGRES_DB=paseo
POSTGRES_USER=paseo
POSTGRES_PASSWORD=cambia-esta-contraseña

# Secreto para firmar los JWT (minimo 32 caracteres)
PASEO_JWT_SECRETO=cambia-este-secreto-por-uno-largo-y-aleatorio

# Puertos en tu maquina
POSTGRES_PUERTO=5432
BACKEND_PUERTO=8080
FRONTEND_PUERTO=8081
